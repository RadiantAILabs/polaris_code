{
  "description": "The done gate holds a final message while the check fails, then lets one through once the check passes; the report cites the recorded check.",
  "workspace": "value",
  "exercises": ["gate", "report"],
  "args": ["--protect", "test.py", "--test-command", "python3 test.py"],
  "runs": [
    {"name": "steps", "args": ["--rules-arm", "steps"]},
    {"name": "moved", "args": ["--rules-arm", "moved"]},
    {"name": "prompt-gate", "args": ["--rules-arm", "prompt-gate"]}
  ],
  "replies": [
    {"text": "All tests pass."},
    {
      "calls": [
        {
          "tool": "edit_file",
          "arguments": {
            "path": "solution.py",
            "old_string": "VALUE = 2",
            "new_string": "VALUE = 1",
            "replace_all": false
          }
        }
      ]
    },
    {"text": "Fixed it; all tests pass."}
  ]
}
